{
  "openapi": "3.1.0",
  "info": {
    "title": "Flagship API",
    "version": "0.1.0",
    "description": "Learning API contract. This document is not a production security certification."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Service is alive"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "summary": "Service metadata",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/api/v1/validate": {
      "post": {
        "summary": "Validate a small JSON object",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "role": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valid payload"
          },
          "400": {
            "description": "Invalid payload"
          },
          "413": {
            "description": "Payload exceeds 16 KB"
          },
          "415": {
            "description": "Unsupported media type"
          }
        }
      }
    }
  }
}